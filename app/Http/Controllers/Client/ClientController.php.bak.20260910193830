    // معالجة إنشاء مستخدم جديد
    public function register(Request $request)
    {
        $validated = $request->validate([
            'name' => ['required', 'string', 'max:255'],
            'email' => ['required', 'email', 'max:255', 'unique:users,email'],
            'avatar' => ['nullable', 'image', 'mimes:jpeg,png,jpg', 'max:2048'],
            'national_id' => ['required', 'string'],
            'phone' => ['required', 'string', 'max:255'],
            'gender' => ['required', 'in:male,female'],
            'city' => ['required', 'string', 'max:255'],
            'password' => ['required', 'confirmed', 'min:6'],

            // التحقق من مدخلات التاريخ بمرونة
            'birth_type' => ['required', 'in:gregorian,hijri'],
            'birth_date' => ['required_if:birth_type,gregorian', 'nullable', 'date'],
            'hijri_day' => ['required_if:birth_type,hijri', 'nullable', 'numeric', 'between:1,30'],
            'hijri_month' => ['required_if:birth_type,hijri', 'nullable', 'numeric', 'between:1,12'],
            'hijri_year' => ['required_if:birth_type,hijri', 'nullable', 'numeric', 'between:1350,1450'],
        ]);

        $birthDate = null;
        $birthDateHijri = null;

        if ($validated['birth_type'] === 'gregorian') {
            $birthDate = $validated['birth_date'];

            // تحويل من ميلادي إلى هجري بدقة
            try {
                $date = new \DateTime($birthDate);
                $formatter = new \IntlDateFormatter(
                    'en_US@calendar=islamic-umalqura',
                    \IntlDateFormatter::FULL,
                    \IntlDateFormatter::FULL,
                    'Asia/Riyadh',
                    \IntlDateFormatter::TRADITIONAL,
                    'yyyy-MM-dd'
                );
                $birthDateHijri = $formatter->format($date);
            } catch (\Exception $e) {
                \Log::error('خطأ تحويل من ميلادي لهجري: ' . $e->getMessage());
            }
        } else {
            // صياغة التاريخ الهجري المدخل من الـ Selects
            $day = sprintf('%02d', $validated['hijri_day']);
            $month = sprintf('%02d', $validated['hijri_month']);
            $year = $validated['hijri_year'];
            $birthDateHijri = "{$year}-{$month}-{$day}";

            // تحويل من هجري إلى ميلادي لحفظه بالصيغة القياسية بقاعدة البيانات
            try {
                $cal = \IntlCalendar::createInstance('Asia/Riyadh', 'en_US@calendar=islamic-umalqura');
                $cal->set(\IntlCalendar::FIELD_YEAR, intval($year));
                $cal->set(\IntlCalendar::FIELD_MONTH, intval($month) - 1); // يبدأ العد من صفر في IntlCalendar
                $cal->set(\IntlCalendar::FIELD_DAY_OF_MONTH, intval($day));

                $timestamp = $cal->getTime() / 1000;
                $birthDate = date('Y-m-d', $timestamp);
            } catch (\Exception $e) {
                \Log::error('خطأ تحويل من هجري لميلادي: ' . $e->getMessage());
            }
        }

        $avatarPath = null;
        if ($request->hasFile('avatar')) {
            $file = $request->file('avatar');
            $filename = time() . '_avatar.' . $file->getClientOriginalExtension();

            // 🔒 تعديل أمني: تم تغيير استخدام public_path() إلى استخدام Storage للرفع الآمن
            $path = $file->storeAs('avatars', $filename, 'public');
            $avatarPath = 'storage/' . $path;
        }

        // إنشاء الحساب وحفظ كلا التاريخين
        $user = User::create([
            'name' => $validated['name'],
            'email' => $validated['email'],
            'avatar' => $avatarPath,
            'national_id' => $validated['national_id'],
            'phone' => $validated['phone'],
            'birth_date' => $birthDate,
            'birth_date_hijri' => $birthDateHijri,
            'city' => $validated['city'],
            'password' => \Hash::make($validated['password']),
            'gender' => $validated['gender']
        ]);

        if ($request->expectsJson()) {
            $token = method_exists($user, 'createToken') ? $user->createToken('AburMobileToken')->plainTextToken : null;
            return response()->json([
                'success' => true,
                'message' => 'تم إنشاء الحساب بنجاح وتسجيل الدخول ✨',
                'user'    => $user,
                'token'   => $token
            ], 201, [], JSON_UNESCAPED_UNICODE);
        }

        Auth::login($user);
        $request->session()->regenerate();

        return redirect()->route('client.index');
    }


